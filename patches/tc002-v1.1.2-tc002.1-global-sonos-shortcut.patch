+def test_sonos_remote_captures_rotary_and_rocker_without_local_volume(app):
+    setup_controls(app, autoTransition=True)
+    source = (Path(__file__).parents[1] / 'apps/sonos_remote.ax').read_bytes()
+    request = urllib.request.Request(
+        app.base_url + '/api/v1/apps/script/sonos_remote', source,
+        {'Content-Type': 'text/plain'}, method='PUT')
+    with urllib.request.urlopen(request) as response:
+        assert json.load(response)['error'] is None
+    app('/api/v1/apps/sonos_remote/config', {'long_ms': 800}, 'PATCH')
+    assert current(app) == 'Time'
+    app('/sim/button/select', {'durationMs': 900}, 'POST')
+    wait_screen(app, lambda pixels: current(app) == 'sonos_remote' and any(pixels))
+
+    app('/sim/rotary/right', {}, 'POST')
+    app('/sim/rotary/left', {}, 'POST')
+    app('/sim/button/right', {'durationMs': 100}, 'POST')
+    time.sleep(.25)
+
+    assert current(app) == 'sonos_remote'
+    assert [app('/api/v1/settings')[key] for key in VOLUMES] == [50, 60, 70]
+    assert app('/api/v1/apps')[-1]['error'] is None
+
+    app('/sim/button/select', {'durationMs': 900}, 'POST')
+    deadline = time.monotonic() + 2
+    while current(app) == 'sonos_remote' and time.monotonic() < deadline:
+        time.sleep(.05)
+    assert current(app) != 'sonos_remote'
+
+
+def test_sonos_remote_is_hidden_from_carousel_until_global_hold(app):
+    setup_controls(app, autoTransition=True, appDurationMs=250)
+    source = (Path(__file__).parents[1] / 'apps/sonos_remote.ax').read_bytes()
+    request = urllib.request.Request(
+        app.base_url + '/api/v1/apps/script/sonos_remote', source,
+        {'Content-Type': 'text/plain'}, method='PUT')
+    with urllib.request.urlopen(request) as response:
+        assert json.load(response)['error'] is None
+    seen = set()
+    deadline = time.monotonic() + 4
+    while time.monotonic() < deadline:
+        seen.add(current(app))
+        time.sleep(.05)
+    assert {'Time', 'Date'} <= seen
+    assert 'sonos_remote' not in seen
+
+
+def test_sonos_remote_global_hold_overrides_visible_script(app):
+    setup_controls(app)
+    sonos = (Path(__file__).parents[1] / 'apps/sonos_remote.ax').read_bytes()
+    request = urllib.request.Request(
+        app.base_url + '/api/v1/apps/script/sonos_remote', sonos,
+        {'Content-Type': 'text/plain'}, method='PUT')
+    with urllib.request.urlopen(request) as response:
+        assert json.load(response)['error'] is None
+    consumer = (b'class Consumer\n def on_button_event(btn, event)\n return true\n end\n'
+                b' def draw()\n clear()\n pixel(0, 0, rgb(255, 0, 0))\n end\nend\n'
+                b'return Consumer()')
+    request = urllib.request.Request(
+        app.base_url + '/api/v1/apps/script/consumer', consumer,
+        {'Content-Type': 'text/plain'}, method='PUT')
+    with urllib.request.urlopen(request) as response:
+        assert json.load(response)['error'] is None
+    app('/api/v1/apps/sonos_remote/config', {'long_ms': 800}, 'PATCH')
+    app('/api/v1/apps/active', {'name': 'consumer', 'fast': True}, 'PUT')
+    wait_screen(app, lambda pixels: current(app) == 'consumer' and pixels[0] == 0xFF0000)
+
+    app('/sim/button/select', {'durationMs': 900}, 'POST')
+    wait_screen(app, lambda pixels: current(app) == 'sonos_remote' and any(pixels))
+
