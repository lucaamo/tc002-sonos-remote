@@ -175,6 +177,25 @@ sim::SimScriptStore g_scriptStore;
 script::ScriptServices g_scriptSvc;
 script::ScriptHost* g_scripts = nullptr;

+constexpr const char* kSonosRemoteApp = "sonos_remote";
+
+long sonosRemoteHoldMs() {
+  constexpr long kDefaultMs = 1200;
+  std::string json;
+  if (!g_scriptStore.readStore(kSonosRemoteApp, json)) return kDefaultMs;
+  api::JsonReader reader{std::string_view(json)};
+  if (!reader.enterObject()) return kDefaultMs;
+  while (reader.nextMember()) {
+    if (reader.keyEquals("long_ms")) {
+      long long value = 0;
+      if (reader.isInteger() && reader.asLong(value) && value >= 600 && value <= 3000)
+        return static_cast<long>(value);
+    }
+    if (!reader.skipValue()) break;
+  }
+  return kDefaultMs;
+}
