@@ -403,8 +424,44 @@ int main(int argc, char** argv) {
   display.configure([](const std::string& s, const std::string& p) { g_mqtt.publish(s, p, false); },
                     g_canvas);
   g_periphery.setButtonHook([](int btn, bool pressed) {
+    static bool selectDown = false;
+    static bool globalEligible = false;
+    static bool globalHandled = false;
+    static int64_t selectPressedAt = 0;
+    static long holdMs = 1200;
+
+    if (btn == 1) {
+      const int64_t now = monotonicMs();
+      if (pressed && !selectDown) {
+        selectDown = true;
+        globalEligible = g_engine->currentAppId() != kSonosRemoteApp;
+        globalHandled = false;
+        selectPressedAt = now;
+        holdMs = sonosRemoteHoldMs();
+      }
+      if (pressed && globalEligible && !globalHandled && now - selectPressedAt >= holdMs &&
+          g_engine->switchApp(std::string("{\"name\":\"") + kSonosRemoteApp +
+                              "\",\"fast\":true}")) {
+        globalHandled = true;
+        return true;
+      }
+      if (!pressed) {
+        const bool handled =
+            g_scripts && g_scripts->handleButtonState(g_engine->currentAppId(), btn, false);
+        const bool consumed = globalHandled;
+        selectDown = false;
+        globalEligible = false;
+        globalHandled = false;
+        return consumed || handled;
+      }
+      if (globalHandled) return true;
+    }
     return g_scripts && g_scripts->handleButtonState(g_engine->currentAppId(), btn, pressed);
   });
+  g_periphery.setRockerHook([](int direction) {
+    return g_scripts && g_scripts->handleButton(
+        g_engine->currentAppId(), direction < 0 ? "rocker_left" : "rocker_right");
+  });

   g_scriptSvc.http = &g_scriptHttp;
