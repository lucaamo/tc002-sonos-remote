# @name Sonos Artist Regression
# @headless true
__CONFIG__

import json
import string
import sonos_artist_test_names
var sonos_artist_names = sonos_artist_test_names
import sonos_playlist_test_slots

# Run the actual production class with lexical, app-local fakes. No MQTT
# subscriptions, commands, navigation or speaker settings reach real hardware.
var check_stats = {"count":0}
def check(condition, message)
  if !condition raise "test_failed", message end
  check_stats["count"] += 1
end

def exercise()
  check(size(sonos_playlist_test_slots.entries)==10, "module loads ten configured slots")
  check(sonos_playlist_test_slots.entries[0]=="List 1|spotify:playlist:EXAMPLE_1|playlist", "module keeps first slot")
  check(sonos_playlist_test_slots.entries[9]=="List 10|spotify:playlist:EXAMPLE_10|playlist", "module keeps tenth slot in numeric order")
  var configured_entries = sonos_playlist_test_slots.entries
  var sonos_playlists = module("test_playlists")
  sonos_playlists.entries = []
  check(sonos_artist_names.names.find("VASCO ROSSI") == "VASCO", "module alias parsing")
  check(sonos_artist_names.names.find("NATALIE IMBRUGLIA") == "NATALIE", "second module alias")
  check(sonos_artist_names.names.find("BACKSTREET BOYS") == "", "explicit continuous rule")
  check(sonos_artist_names.names.find("DUPLICATE ARTIST") == "LAST", "last duplicate wins")
  check(sonos_artist_names.names.find("INVALID") == nil, "invalid rule ignored")
  check(sonos_artist_names.names.find("EMPTY ARTIST") == nil, "blank alias ignored")
  check(sonos_artist_names.names.find("GLOBAL ARTIST") == "GLOBAL", "global rules loaded")
  check(sonos_artist_names.names.find("CATALOGUE ARTIST 0") == "C0", "global catalogue first entry")
  check(sonos_artist_names.names.find("CATALOGUE ARTIST 399") == "C399", "global catalogue beyond old per-list limit")
  check(sonos_artist_names.names.find("VASCO ROSSI") == "VASCO", "global override wins")
  var names = sonos_artist_names.names
  var sonos_artist_names = module("test_names")
  sonos_artist_names.names = {"VASCO ROSSI":names.find("VASCO ROSSI"), "NATALIE IMBRUGLIA":names.find("NATALIE IMBRUGLIA"), "ARTISTA LUNGO":"NOME TROPPO LUNGO", "STING":"ST"}
  var calls = []
  var completed = 0
  var clock = 10000
  var now_ms = def () return clock end
  var width = def () return 52 end
  var height = def () return 16 end
  var clear = def () calls.clear() end
  var line = def (x1,y1,x2,y2,c) return nil end
  var icon = def (name,x,y) return false end
  var pixel = def (x,y,c) return nil end
  var text_ink_width = def (s) return size(s) * 5 end
  var text = def (x,y,s,c) calls.push({"kind":"text","x":x,"y":y,"value":s,"color":c}) end
  var rect_fill = def (x,y,w,h,c) calls.push({"kind":"clear","x":x,"y":y,"width":w,"height":h}) end
  var scroll_text = def (x,y,w,s,c,opts) calls.push({"kind":"scroll","value":s,"width":w,"repeat":opts != nil ? opts["repeat"] : 0}); return completed end
  var settings = module("test_settings")
  var navigation_blocked = false
  settings.get = def (key) return nil end
  settings.set = def (key,value) navigation_blocked = value end
  var rotation = module("test_rotation")
  var exits = 0
  rotation.next = def () raise "test_failed", "unsafe Berry exit used" end
  var mqtt = module("test_mqtt")
  var commands = []
  var exit_retained = nil
  mqtt.publish = def (topic,payload,retain)
    if topic == "test_clock/cmd/apps/next"
      exits += 1
      exit_retained = retain
      check(payload == "", "native next payload")
    else
      commands.push(json.load(payload))
    end
  end

__CLASS__

  var app = SonosRemote()
  app.set_artist("Vasco Rossi")
  app.draw_artist(17,35)
  check(size(calls)==1 && calls[0]["kind"]=="scroll" && calls[0]["value"]=="VASCO ROSSI", "full first pass")
  check(!app.artist_done, "not complete too early")
  check(calls[0]["repeat"]==1, "alias requests one native pass")
  calls.clear()
  completed = 1
  app.draw_artist(17,35)
  check(app.artist_done && calls[-1]["value"]=="VASCO", "alias after complete pass")
  check(calls[-1]["x"]==22 && calls[-1]["color"]==0xFFFFFF, "centered white alias")
  var hold = app.header_scroll["holdMs"]
  app.on_state(app.root+"/state/artist", "vasco rossi")
  check(app.artist_done && app.header_scroll["holdMs"]==hold, "duplicate normalized MQTT does not reset")
  calls.clear()
  app.draw_artist(17,35)
  check(size(calls)==2 && calls[-1]["value"]=="VASCO", "alias persists on repeated frames")
  app.set_artist("Mario Rossi")
  check(!app.artist_done && app.header_scroll["holdMs"]!=hold, "equal-width new artist resets renderer")
  app.set_artist("Backstreet Boys")
  calls.clear()
  app.draw_artist(17,35)
  app.draw_artist(17,35)
  check(size(calls)==2 && calls[0]["kind"]=="scroll" && calls[1]["value"]=="BACKSTREET BOYS", "unconfigured group keeps scrolling")
  check(calls[0]["repeat"]==0 && calls[1]["repeat"]==0, "unconfigured artist has unlimited native passes")
  app.set_artist("Artista Lungo")
  calls.clear()
  app.draw_artist(17,35)
  check(size(calls)==1 && calls[0]["kind"]=="scroll", "oversized alias keeps full name")
  check(calls[0]["repeat"]==0, "oversized alias has unlimited native passes")
  app.set_artist("Sting")
  calls.clear()
  app.draw_artist(17,35)
  check(size(calls)==1 && calls[0]["value"]=="STING" && calls[0]["x"]==22, "fitting full name centered unchanged")
  app.set_artist("Vasco Rossi")
  app.artist_done = true
  hold = app.header_scroll["holdMs"]
  app.enter_mode()
  check(!app.artist_done && app.header_scroll["holdMs"]!=hold, "reentry restarts first pass")
  app.artist_done = true
  calls.clear()
  app.draw_artist(17,24)
  check(size(calls)==1 && calls[0]["kind"]=="scroll", "width change never clips alias")
  app.set_artist("")
  calls.clear()
  app.draw_artist(17,35)
  check(calls[-1]["value"]=="SONOS", "missing artist fallback")
  app.player = "media_player.example"
  app.device_root = "test_clock"
  app.on_show()
  check(app.active && navigation_blocked, "native on-show owns active controls")
  commands.clear()
  app.on_button_event("select", "press")
  clock += 100
  check(app.on_button_event("select", "release"), "native press claimed")
  check(size(commands)==0, "short native select has no duplicate music action")
  app.on_button_event("select", "press")
  clock += 1000
  app.on_button_event("select", "release")
  check(size(commands)==0, "firmware long-release never toggles playback")
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += app.long_ms
  app.on_control("test_clock/state/buttons/knob", "0")
  check(!app.picker && exits==0 && size(commands)==0, "hold with no playlists is harmless")
  app.volume = 40
  app.on_button_event("right", "press")
  check(app.volume==45 && commands[-1]["value"]==45, "native right changes Sonos")
  var first_osd = app.osd_until
  clock += 500
  app.on_button_event("right", "repeat")
  check(app.volume==50 && app.osd_until==first_osd+500, "repeat restarts two-second OSD")
  app.picker = true
  app.draw()
  check(calls[-2]["value"]=="SONOS" && calls[-1]["value"]=="50%", "volume feedback takes priority over picker")
  app.picker = false
  app.on_state(app.root+"/state/volume", "45")
  check(app.volume==50, "old volume ignored while command pending")
  app.on_state(app.root+"/state/volume", "50")
  app.on_state(app.root+"/state/volume", "45")
  check(app.volume==50, "old report after matching echo also ignored")
  clock += 3001
  app.on_state(app.root+"/state/volume", "48")
  check(app.volume==48 && app.label=="48%", "observed volume reconciles after settling")
  app.on_state(app.root+"/state/volume", "101")
  check(app.volume==48, "invalid volume rejected")
  commands.clear()
  app.on_control("test_clock/state/buttons/right", "1")
  check(size(commands)==0, "duplicate MQTT button ignored")
  app.on_control("test_clock/event/knob", "{\"turn\":1}")
  check(size(commands)==1 && commands[-1]["action"]=="next", "MQTT rotary advances track")
  app.on_control("test_clock/event/knob", "{\"turn\":-1}")
  check(commands[-1]["action"]=="previous", "MQTT rotary reverses track")
  app.add_playlist("Test list|spotify:playlist:EXAMPLE|playlist")
  app.add_playlist("Second|SQ:10|favorite_item_id")
  app.add_playlist("Third|spotify:playlist:THIRD|playlist")
  app.add_playlist("Fourth|spotify:playlist:FOURTH|playlist")
  app.on_hide()
  app.on_show()
  app.on_control("test_clock/state/buttons/knob", "0")
  check(app.picker, "entry release cannot launch playlist")
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += 100
  app.on_control("test_clock/state/buttons/knob", "0")
  check(!app.picker && commands[-1]["action"]=="play_media", "short knob selection starts named playlist")
  check(commands[-1]["media_content_id"]=="spotify:playlist:EXAMPLE", "playlist ID preserved")
  app.load_cover("not JSON")
  check(size(app.cover)==0, "malformed cover does not crash")
  var pixels = []
  for i : 0 .. 255 pixels.push(0x123456) end
  app.load_cover(json.dump({"width":16,"height":16,"pixels":pixels}))
  check(size(app.cover)==256, "valid artwork accepted")
  pixels[0] = -1
  app.load_cover(json.dump({"width":16,"height":16,"pixels":pixels}))
  check(size(app.cover)==0, "invalid RGB pixel rejected")
  commands.clear()
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += app.long_ms - 1
  app.on_control("test_clock/state/buttons/knob", "0")
  check(exits==0 && commands[-1]["action"]=="play_pause", "below hold boundary remains short press")
  commands.clear()
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += app.long_ms
  app.on_control("test_clock/state/buttons/knob", "0")
  check(app.picker && !app.exit_pending && exits==0 && size(commands)==0, "hold boundary opens picker without exiting or playback")
  check(app.picker_until==clock+app.picker_ms, "opening picker starts fresh timeout")
  app.on_control("test_clock/state/buttons/knob", "0")
  check(app.picker && size(commands)==0, "duplicate long release never confirms")
  app.on_control("test_clock/event/knob", "{\"turn\":-1}")
  check(app.playlist_index==3 && size(commands)==0, "picker wraps backwards without track commands")
  clock += 500
  app.on_control("test_clock/event/knob", "{\"turn\":2}")
  check(app.playlist_index==1 && app.picker_until==clock+app.picker_ms && size(commands)==0, "picker wraps forwards and renews timeout")
  app.on_button_event("select", "press")
  clock += 100
  app.on_button_event("select", "release")
  check(app.picker && size(commands)==0, "short top select cannot confirm picker")
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += app.long_ms
  app.on_control("test_clock/state/buttons/knob", "0")
  check(!app.picker && app.picker_until==0 && app.playlist_index==1 && size(commands)==0 && exits==0, "second hold cancels without changing playback or choice")
  app.osd_until = clock+2000
  app.pending_until = clock+3000
  var pending = app.pending_until
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += app.long_ms
  app.on_control("test_clock/state/buttons/knob", "0")
  check(app.picker && app.playlist_index==1 && app.osd_until==0, "reopen retains choice and immediately dismisses volume overlay")
  check(app.pending_until==pending, "opening picker preserves stale-volume protection")
  calls.clear()
  app.draw()
  check(calls[0]["value"]=="PLAYLIST" && calls[-1]["value"]=="Second", "opened picker renders selected playlist")
  app.on_control("test_clock/state/buttons/knob", "1")
  clock += 100
  app.on_control("test_clock/state/buttons/knob", "0")
  check(!app.picker && app.picker_until==0 && size(commands)==1 && commands[-1]["action"]=="play_media", "short press confirms reopened picker exactly once")
  check(commands[-1]["media_content_id"]=="SQ:10" && commands[-1]["media_content_type"]=="favorite_item_id", "selected favourite content and type preserved")
  commands.clear()
  app.open_picker()
  var deadline = app.picker_until
  app.on_state(app.root+"/state/title", "Current track")
  app.on_state(app.root+"/state/volume", "48")
  check(app.picker && app.picker_until==deadline, "periodic metadata never closes or restarts picker")
  clock = deadline-1
  app.loop()
  check(app.picker, "picker remains before timeout boundary")
  clock = deadline
  app.loop()
  check(!app.picker && app.picker_until==0 && exits==0, "timeout boundary returns to music without exit")
  var only_refresh = true
  for command : commands
    if command["action"]!="refresh" only_refresh = false end
  end
  check(only_refresh, "picker timeout never launches or toggles music")
  calls.clear()
  app.draw()
  check(calls[-1]["value"]=="Current track", "timeout restores now-playing display")
  commands.clear()
  app.on_control("test_clock/event/knob", "{\"turn\":1}")
  check(commands[-1]["action"]=="next", "rotary returns to track control after timeout")
  commands.clear()
  app.exit_mode()
  check(exits==1 && app.exit_pending && size(commands)==0, "backend exit requests native path without playback")
  check(exit_retained==false, "exit command is never retained")
  app.exit_mode()
  app.on_control("test_clock/state/buttons/knob", "0")
  app.on_control("test_clock/event/knob", "{\"turn\":1}")
  app.on_button_event("right", "press")
  check(exits==1 && size(commands)==0, "pending exit suppresses duplicate exit and media actions")
  clock += 2499
  app.loop()
  check(exits==1, "exit retry bounded")
  clock += 1
  app.loop()
  check(exits==2 && size(commands)==0, "lost exit retries without refresh or media commands")
  app.on_hide()
  check(!app.exit_pending && !navigation_blocked, "native hide clears exit state and navigation")
  app.on_show()
  check(app.active && !app.exit_pending, "fresh session can be used after exit")
  app.last_state = clock
  var received = app.last_state
  clock += 3000
  app.loop()
  check(app.last_state==received && commands[-1]["action"]=="refresh", "refresh never fabricates backend heartbeat")
  clock += 65001
  app.loop()
  check(exits==3 && app.exit_pending, "offline backend requests same native exit")
  app.on_hide()
  check(!app.active && !navigation_blocked && app.pressed_at==-1 && !app.picker, "hide releases navigation and press state")
  commands.clear()
  app.on_control("test_clock/state/buttons/knob", "1")
  check(app.pressed_at==-1, "inactive knob press is ignored")
  app.on_control("test_clock/event/knob", "{\"turn\":1}")
  check(size(commands)==0, "inactive app never handles rotary")
  sonos_playlists.entries = configured_entries
  var expanded = SonosRemote()
  check(size(expanded.playlists)==10, "production init parses all ten module entries")
  expanded.player = "media_player.example"
  expanded.device_root = "test_clock"
  expanded.enter_mode()
  commands.clear()
  expanded.on_control("test_clock/event/knob", "{\"turn\":-1}")
  check(expanded.playlist_index==9 && size(commands)==0, "ten-slot picker wraps first to tenth")
  calls.clear()
  expanded.draw()
  check(calls[-1]["value"]=="List 10", "tenth playlist name renders")
  expanded.on_control("test_clock/state/buttons/knob", "1")
  clock += 100
  expanded.on_control("test_clock/state/buttons/knob", "0")
  check(!expanded.picker && commands[-1]["media_content_id"]=="spotify:playlist:EXAMPLE_10", "tenth playlist confirmation selects correct content")
  expanded.open_picker()
  expanded.on_control("test_clock/event/knob", "{\"turn\":1}")
  check(expanded.playlist_index==0, "ten-slot picker wraps tenth to first")
  expanded.on_control("test_clock/event/knob", "{\"turn\":21}")
  check(expanded.playlist_index==1, "multi-turn events wrap over ten entries")
  expanded.on_control("test_clock/event/knob", "{\"turn\":-22}")
  check(expanded.playlist_index==9, "negative multi-turn events wrap over ten entries")
  sonos_playlists.entries = [configured_entries[0], "", "invalid", configured_entries[9]]
  var sparse = SonosRemote()
  check(size(sparse.playlists)==2 && sparse.playlists[1]["name"]=="List 10", "blank and invalid slots are skipped without losing tenth")
  expanded.on_hide()
  shared.set("sonos_artist_regression", str(check_stats["count"])+" runtime checks passed")
end

class Regression
  def setup() exercise() end
end
return Regression()
