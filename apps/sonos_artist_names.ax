# @module sonos_artist_names
# @name Sonos Artist Names
# @author lucaamo
# @display 52x16
# License: PolyForm Noncommercial 1.0.0; https://github.com/lucaamo/tc002-sonos-remote/blob/main/LICENSE.md
# Required Notice: Copyright © Stephan Mühl (Blueforcer) https://github.com/Blueforcer/awtrix-ng
# @desc Optional global artist aliases, independent of playlists. Full names scroll by default.
# @version 2.0.0
# @config rules text "Global artist rules" default="" maxlen=16384 help="Optional, for every playlist and source. Full name|Short name; separate with ;. Empty keeps full names. Use * for continuous full-name scrolling."
# @config overrides text "Global rule overrides" default="" maxlen=2048 help="Optional rules with priority over Global artist rules. Full name|Short name; separate with ;. Use * to keep a full name."

import string

var m = module("sonos_artist_names")
m.names = {}
# Read under the module identity; calling-app functions have a different store.
for key : ["rules", "overrides"]
  var spec = store.get(key)
  if spec != nil && spec != ""
    for entry : string.split(spec, ";")
      var pair = re.search("^\\s*([^|]+?)\\s*\\|\\s*([^|]+?)\\s*$", entry)
      if pair != nil
        var full = string.toupper(pair[1])
        var short = string.toupper(pair[2])
        if re.search("\\S", full) != nil && re.search("\\S", short) != nil
          m.names[full] = short == "*" ? "" : short
        end
      elif entry != ""
        log("Sonos artist names: ignored invalid rule")
      end
    end
  end
end
return m
