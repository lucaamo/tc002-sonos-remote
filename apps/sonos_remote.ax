# @name Sonos Remote
# @desc TC002 physical remote for one Home Assistant media player
# @version 3.1.0
# @ondemand
# @config root text "MQTT topic root" default="tc002/sonos_remote/v2" maxlen=96 help="Must match the Home Assistant blueprint MQTT root"
# @config device_root text "AWTRIX MQTT topic prefix" default="" maxlen=96 help="Copy System > MQTT > Topic prefix from your TC002"
# @config player text "Sonos player entity" default="" maxlen=128 help="Home Assistant entity, for example media_player.living_room"
# @config step number "Volume step (%)" default=5 min=1 max=25
# @config long_ms number "Playlist picker hold (ms)" default=1200 min=600 max=3000 help="Hold and release the knob to open or cancel playlist selection"
# @config picker_ms number "Playlist picker timeout (ms)" default=8000 min=3000 max=30000 step=1000
# @config playlist1 text "Playlist 1" default="" maxlen=768 help="Name|content id|content type"
# @config playlist2 text "Playlist 2" default="" maxlen=768 help="Name|content id|content type"
# @config playlist3 text "Playlist 3" default="" maxlen=768 help="Name|content id|content type"
# @config playlist4 text "Playlist 4" default="" maxlen=768 help="Name|content id|content type"
# @config icon_name text "Music Meter icon name" default="sonos_music_meter" maxlen=64
# @config accent color "Music icon colour" default=#35DCC4

import json
import string
import sonos_artist_names

class SonosRemote
  var root, device_root, player, step, long_ms, picker_ms, icon_name, accent
  var title, artist, playing, volume, label, artist_done, artist_rest, header_scroll
  var active, exit_pending, session_started, pressed_at, osd_until, pending_until, last_state, last_refresh, entered_at
  var playlists, picker, playlist_index, picker_until
  var cover

  def init()
    self.root = store.get("root")
    self.device_root = store.get("device_root")
    self.player = store.get("player")
    self.step = store.get("step")
    self.long_ms = store.get("long_ms")
    self.picker_ms = store.get("picker_ms")
    if self.picker_ms == nil self.picker_ms = 8000 end
    self.icon_name = store.get("icon_name")
    self.accent = store.get("accent")
    if self.accent == nil self.accent = settings.get("textColor") end
    if self.accent == nil self.accent = 0x35DCC4 end
    self.title = "Press to start"
    self.artist = "SONOS"
    self.artist_done = false
    self.artist_rest = ""
    self.header_scroll = {"mode":"wrap", "direction":"left", "repeat":1, "holdMs":700, "whenFits":"static"}
    self.playing = false
    self.volume = -1
    self.label = "--%"
    self.active = false
    self.exit_pending = false
    self.session_started = false
    self.pressed_at = -1
    self.osd_until = 0
    self.pending_until = 0
    self.last_state = 0
    self.last_refresh = 0
    self.entered_at = 0
    self.playlists = []
    self.add_playlist(store.get("playlist1"))
    self.add_playlist(store.get("playlist2"))
    self.add_playlist(store.get("playlist3"))
    self.add_playlist(store.get("playlist4"))
    self.picker = false
    self.playlist_index = 0
    self.picker_until = 0
    self.cover = []
  end

  def setup()
    mqtt.subscribe(self.root + "/state/#", / topic, payload -> self.on_state(topic, payload))
    if self.device_root != ""
      mqtt.subscribe(self.device_root + "/state/buttons/knob", / topic, payload -> self.on_control(topic, payload))
      mqtt.subscribe(self.device_root + "/event/knob", / topic, payload -> self.on_control(topic, payload))
    else
      log("Sonos Remote: configure the AWTRIX MQTT topic prefix")
    end
    # Native buttons use on_button_event; never subscribe to their MQTT copies.
    # On-demand setup runs only on launch, including an API launch. Start here
    # as beta 1.1.5 does not deliver on_show on every on-demand start path.
    self.enter_mode()
  end

  def enter_mode()
    self.restart_artist()
    self.active = true
    self.exit_pending = false
    self.session_started = false
    self.osd_until = 0
    self.playlist_index = 0
    self.open_picker()
    settings.set("blockNavigation", true)
    self.entered_at = now_ms()
    self.last_refresh = now_ms()
    self.send("refresh")
    log("Sonos Remote: control on")
  end

  def on_control(topic, payload)
    if !self.active || self.exit_pending return end
    var knob_button = self.device_root + "/state/buttons/knob"
    if topic == knob_button
      if payload == "1"
        self.pressed_at = now_ms()
        return
      end
      if payload == "0" && self.pressed_at >= 0
        var held = now_ms() - self.pressed_at
        self.pressed_at = -1
        if held >= self.long_ms
          if self.picker self.close_picker()
          else self.open_picker() end
        else
          self.confirm_or_toggle()
        end
      end
      return
    end
    if topic == self.device_root + "/event/knob"
      var m = re.search("\\\"turn\\\":[ ]*(-?[0-9]+)", payload)
      if m != nil
        var turns = num(m[1], 0)
        if self.picker && size(self.playlists) > 0
          var count = size(self.playlists)
          self.playlist_index = (self.playlist_index + turns) % count
          if self.playlist_index < 0 self.playlist_index += count end
          self.picker_until = now_ms() + self.picker_ms
        else
          if turns > 0 self.send("next")
          elif turns < 0 self.send("previous") end
          self.session_started = true
        end
      end
      return
    end
  end

  def confirm_or_toggle()
    if self.picker && size(self.playlists) > 0
      self.send_playlist(self.playlists[self.playlist_index])
      self.close_picker()
    else
      self.send("play_pause")
    end
    self.session_started = true
  end

  def open_picker()
    if size(self.playlists) == 0 return end
    self.picker = true
    self.picker_until = now_ms() + self.picker_ms
    # A deliberate picker request must be visible immediately. Keep the
    # independent volume settling window so stale HA echoes remain ignored.
    self.osd_until = 0
  end

  def close_picker()
    self.picker = false
    self.picker_until = 0
  end

  def on_button_event(btn, event)
    if !self.active || self.exit_pending return true end
    # Select hold is the firmware's local exit. Its short press and synthetic
    # hold release must never launch a playlist or toggle Sonos playback.
    if event == "press" || event == "repeat"
      if btn == "right" self.adjust_volume(self.step)
      elif btn == "left" self.adjust_volume(-self.step) end
    end
    return true
  end

  def adjust_volume(delta)
    self.osd_until = now_ms() + 2000
    if self.volume < 0
      self.send_value("delta", delta)
      return
    end
    var target = self.volume + delta
    if target < 0 target = 0 end
    if target > 100 target = 100 end
    self.volume = target
    self.label = str(target) + "%"
    self.pending_until = now_ms() + 3000
    self.send_value("volume", target)
  end

  def send(action)
    if self.player == nil || self.player == "" return end
    mqtt.publish(self.root + "/command", json.dump({"action":action, "player_entity_id":self.player}))
  end

  def send_value(action, value)
    if self.player == nil || self.player == "" return end
    mqtt.publish(self.root + "/command", json.dump({"action":action, "player_entity_id":self.player, "value":value}))
  end

  def send_playlist(item)
    if self.player == nil || self.player == "" return end
    var content_id = item.find("mediaContentId")
    var content_type = item.find("mediaContentType")
    if content_id == nil || content_id == "" return end
    if content_type == nil || content_type == "" content_type = "playlist" end
    mqtt.publish(self.root + "/command", json.dump({"action":"play_media", "player_entity_id":self.player, "media_content_id":content_id, "media_content_type":content_type}))
    self.session_started = true
  end

  def add_playlist(spec)
    if spec == nil || spec == "" return end
    var match = re.search("^([^|]+)\\|([^|]+)\\|([^|]+)$", spec)
    if match == nil
      log("Sonos Remote: invalid playlist setting")
      return
    end
    self.playlists.push({"name":match[1], "mediaContentId":match[2], "mediaContentType":match[3]})
  end

  def on_state(topic, payload)
    self.last_state = now_ms()
    if topic == self.root + "/state/title"
      self.title = payload == "" ? "Press to start" : payload
    elif topic == self.root + "/state/artist"
      self.set_artist(payload)
    elif topic == self.root + "/state/playing"
      self.playing = payload == "playing"
    elif topic == self.root + "/state/volume"
      var observed = num(payload)
      if observed != nil && observed >= 0 && observed <= 100
        if now_ms() >= self.pending_until
          self.volume = int(observed)
          self.label = str(self.volume) + "%"
        end
      end
    elif topic == self.root + "/state/player_name"
      if self.artist == "SONOS" && payload != ""
        self.set_artist(payload)
      end
    elif topic == self.root + "/state/cover"
      self.load_cover(payload)
    elif topic == self.root + "/state/error" && payload != ""
      self.title = payload
    end
  end

  def restart_artist()
    self.artist_done = false
    # AWTRIX keys scrolling by geometry, not text. A 1 ms hold change also
    # restarts equal-width artist changes; duplicate MQTT reports never call it.
    self.header_scroll["holdMs"] = self.header_scroll["holdMs"] == 700 ? 701 : 700
  end

  def set_artist(payload)
    var next_artist = payload == "" ? "SONOS" : string.toupper(payload)
    if next_artist == self.artist return end
    self.artist = next_artist
    self.artist_rest = sonos_artist_names.names.find(next_artist, "")
    self.restart_artist()
  end

  def draw_artist(text_x, text_w)
    var full_w = text_ink_width(self.artist)
    if full_w <= text_w
      text(text_x + (text_w - full_w) / 2, 5, self.artist, 0xFFFFFF)
      return
    end
    # Only an explicitly configured, fitting alias may replace the full name.
    # Unknown artists, groups and oversized aliases keep scrolling intact.
    var short_w = text_ink_width(self.artist_rest)
    var use_short = self.artist_rest != "" && short_w <= text_w
    if !use_short
      scroll_text(text_x, 5, text_w, self.artist, 0xFFFFFF, self.header_scroll)
      return
    end
    if !self.artist_done
      self.artist_done = scroll_text(text_x, 5, text_w, self.artist, 0xFFFFFF, self.header_scroll) > 0
    end
    if self.artist_done
      # Switch in the same frame, without leftover pixels from the last pass.
      rect_fill(text_x, 0, text_w, 6, 0x000000)
      text(text_x + (text_w - short_w) / 2, 5, self.artist_rest, 0xFFFFFF)
    end
  end

  def load_cover(payload)
    self.cover = []
    if payload == "" return end
    try
      var data = json.load(payload)
      if !isinstance(data, map) return end
      if data.find("width") != 16 || data.find("height") != 16 return end
      var pixels = data.find("pixels")
      if !isinstance(pixels, list) || size(pixels) != 256 return end
      for value : pixels
        if type(value) != "int" || value < 0 || value > 0xFFFFFF return end
      end
      self.cover = pixels
    except ..
      log("Sonos Remote: invalid artwork ignored")
    end
  end

  def loop()
    if !self.active return end
    var now = now_ms()
    if self.exit_pending
      # QoS 0 may lose a command; retry until native on_hide unloads us.
      if now - self.last_refresh >= 2500
        self.last_refresh = now
        mqtt.publish(self.device_root + "/cmd/apps/next", "", false)
      end
      return
    end
    if self.picker && self.picker_until != 0 && now >= self.picker_until
      self.close_picker()
    end
    if now - self.last_refresh >= 2500
      self.send("refresh")
      self.last_refresh = now
    end
    var alive = self.last_state == 0 ? self.entered_at : self.last_state
    if now - alive > 65000
      log("Sonos Remote: Home Assistant offline, ending session")
      self.exit_mode()
    end
  end

  def on_show()
    # @ondemand owns carousel suspension and unloads this app on exit.
    if !self.active self.enter_mode() end
  end

  def on_hide()
    self.pressed_at = -1
    settings.set("blockNavigation", false)
    self.active = false
    self.exit_pending = false
    self.osd_until = 0
    self.pending_until = 0
    self.close_picker()
  end

  def exit_mode()
    if !self.active || self.exit_pending return end
    # Beta 1.1.5 rotation.next() relaunches the on-demand script. The native
    # MQTT command follows the working HTTP next path and unloads it safely.
    self.exit_pending = true
    self.pressed_at = -1
    self.last_refresh = now_ms()
    mqtt.publish(self.device_root + "/cmd/apps/next", "", false)
  end

  def draw()
    clear()
    if height() < 16
      scroll_text(1, 6, width() - 2, self.title, 0xFFFFFF)
      return
    end
    if self.active && now_ms() < self.osd_until
      rect_fill(1, 6, 3, 5, 0x38BDF8)
      line(4, 6, 7, 3, 0x2563EB)
      line(7, 3, 7, 12, 0x2563EB)
      line(7, 12, 4, 10, 0x2563EB)
      var phase = (now_ms() / 140) % 3
      line(9, 6-phase, 9, 9+phase, 0x35E6B4)
      line(11, 4+phase, 11, 11-phase, 0xF7C948)
      line(13, 6-phase, 13, 9+phase, 0xFF45A4)
      var osd_x = 17
      var osd_w = width() - osd_x
      text(osd_x + (osd_w - text_ink_width("SONOS")) / 2, 5, "SONOS", 0xFFFFFF)
      text(osd_x + (osd_w - text_ink_width(self.label)) / 2, 14, self.label, 0xFFFFFF)
      return
    end
    if self.active && self.picker && size(self.playlists) > 0
      var heading = "PLAYLIST"
      var heading_w = text_ink_width(heading)
      text((width() - heading_w) / 2, 5, heading, 0xFFFFFF)
      var item = self.playlists[self.playlist_index]
      var name = item.find("name")
      if name == nil name = "Playlist" end
      var body_x = 4
      var body_w = width() - 8
      var body_ink = text_ink_width(name)
      line(0, 10, 2, 8, self.accent)
      line(0, 10, 2, 12, self.accent)
      line(width()-1, 10, width()-3, 8, self.accent)
      line(width()-1, 10, width()-3, 12, self.accent)
      if body_ink <= body_w
        text(body_x + (body_w - body_ink) / 2, 14, name, 0xFFFFFF)
      else
        scroll_text(body_x, 14, body_w, name, 0xFFFFFF)
      end
      return
    end
    if size(self.cover) == 256
      for cover_y : 0 .. 15
        for cover_x : 0 .. 15
          pixel(cover_x, cover_y, self.cover[cover_y * 16 + cover_x])
        end
      end
    # Optional local Music Meter; shapes are the portable fallback.
    elif !icon(self.icon_name, 3, 3)
      var beat = (now_ms() / 160) % 3
      rect_fill(4, 12-beat, 2, 3+beat, self.accent)
      rect_fill(7, 9+beat, 2, 6-beat, 0x38BDF8)
      rect_fill(10, 7-beat, 2, 8+beat, 0xFF45A4)
    end
    var text_x = 17
    var text_w = width() - text_x
    self.draw_artist(text_x, text_w)
    var title_ink = text_ink_width(self.title)
    if title_ink <= text_w
      text(text_x + (text_w - title_ink) / 2, 14, self.title, 0xFFFFFF)
    else
      scroll_text(text_x, 14, text_w, self.title, 0xFFFFFF)
    end
  end
end

return SonosRemote()
